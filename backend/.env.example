# OutEye Edu 后端环境变量示例（复制为 .env 后按环境填写）

# ---- LLM（必填） ----
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- 数据库 / 缓存（按部署填写） ----
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/outeye
# REDIS_URL=redis://localhost:6379/0

# ---- 视觉质检多模态模型（S6，可选：不配则视觉质检自动跳过） ----
# DashScope OpenAI 兼容模式，模型可用 qwen-vl-plus / qwen-vl-max
VISION_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-plus

# ---- 课件质检链路回滚开关（S5-S7；紧急时可单层关闭降级到基础生成） ----
PAGE_REVIEWER_ENABLED=true
VISUAL_QC_ENABLED=true
CONSISTENCY_REVIEW_ENABLED=true
